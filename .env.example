SOFTORASYSTEMS_ADDRESS="Softora Systems, Office 12, Example Street, City, Postal Code, Pakistan"
SOFTORASYSTEMS_TOKEN=

# Public hostname. When set, deploy_vultr.sh starts Caddy and provisions HTTPS.
# Leave blank for a plain-IP deployment on port 80.
DOMAIN=

# PayPal (developer.paypal.com > Apps & Credentials > Sandbox > your app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_BRAND_NAME=Dealwright
# Webhook ID from the same app's Webhooks section (URL: https://<your-host>/api/paypal/webhook).
# Optional locally: the buyer return URL captures payments without webhooks.
PAYPAL_WEBHOOK_ID=
# Public URL used in PayPal return links and client pay links (e.g. https://Dealwright.onrender.com)
PUBLIC_BASE_URL=

# LLM: any OpenAI-compatible provider. OpenRouter gives access to Claude, GPT, Llama, etc.
OPENROUTER_API_KEY=
# Pick a fast model for live demos (the Wren router budget is VIO_ROUTER_TIMEOUT seconds, default 8)
OPENROUTER_MODEL=

# Optional: Vultr Serverless Inference (https://api.vultrinference.com/v1)
VULTR_INFERENCE_API_KEY=
VULTR_MODEL=meta/llama-3.1-70b-instruct

# Outreach identity (CAN-SPAM / GDPR)
GROWTH_SENDER_NAME="Your Name"
GROWTH_SENDER_EMAIL="you@yourdomain"
GROWTH_POSTAL_ADDRESS="Your street, city, country"
