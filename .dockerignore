# Version control & local tooling
.git
.gitignore
__pycache__/
*.py[cod]
*.log
.venv/
venv/

# Secrets must never be baked into the image; they are injected at runtime
.env
.env.*

# Local state / databases (mounted as volumes instead)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Generated artifacts / docs not needed at runtime
docs/
srv.pid
iso.dom
iso.err
crm.log
