{
  "max_seconds": 178,
  "vars": {"base": "http://localhost:8791", "token": "demo-recording-token-000000"},
  "setup": [
    {"do": "goto", "url": "{base}/"},
    {"do": "eval", "js": "sessionStorage.setItem('t','demo-recording-token-000000')"},
    {"do": "goto", "url": "{base}/", "settle": 2.5}
  ],
  "scenes": [
    {"id": "hook", "min": 7,
     "say": "A software company lives or dies on the gap between a signed deal and a paid, delivered project. Dealwright runs that whole journey with people and AI agents, on PayPal.",
     "actions": [{"do": "card", "title": "Dealwright", "subtitle": "Your whole software company, run by people and AI agents, from first lead to paid delivery on PayPal", "ms": 0}]},

    {"id": "company",
     "say": "Twenty departments, from Sales to Finance, each staffed by people, AI agents, or both, with live KPIs.",
     "actions": [{"do": "uncard"}, {"do": "click", "sel": "[data-v=org]"}, {"do": "wait_for", "text": "Client-to-delivery lifecycle"},
                 {"do": "move", "text": "Client-to-delivery lifecycle"}, {"do": "wait", "s": 1.2}, {"do": "scroll_to", "text": "Software Engineering"}]},

    {"id": "sales",
     "say": "Sales agents research every prospect, with evidence quoted from the prospect's own website.",
     "actions": [{"do": "click", "sel": "[data-v=table]"}, {"do": "wait_for", "text": "FinFlow Payments"}, {"do": "click", "text": "FinFlow Payments"},
                 {"do": "wait_for", "text": "Opportunity / Audit Finding"}, {"do": "move", "text": "Opportunity / Audit Finding"}]},

    {"id": "proposal",
     "say": "The proposal agent writes a scoped proposal with three pricing tiers.",
     "actions": [{"do": "click", "text": "Dealwright Proposal"}, {"do": "wait_for", "text": "Proposal generated successfully", "timeout": 60}, {"do": "wait", "s": 1.0},
                 {"do": "wait_for", "text": "View Full SOW", "timeout": 20}, {"do": "click", "text": "View Full SOW"}, {"do": "wait_for", "text": "Executive Summary"},
                 {"do": "wait", "s": 0.8}, {"do": "scroll_to", "text": "Commercial Investment"}]},

    {"id": "paylink",
     "say": "One click makes it payable: PayPal Orders for one-time work, PayPal Subscriptions for retainers.",
     "actions": [{"do": "click", "text": "PayPal checkout link"}, {"do": "wait_for", "sel": "#paylink_out a"}, {"do": "move", "sel": "#paylink_out a"},
                 {"do": "eval", "js": "document.querySelector('#paylink_out a').href", "save": "paylink"}]},

    {"id": "client",
     "say": "The client sees the proposal, and a PayPal button on every plan.",
     "actions": [{"do": "goto", "url": "{paylink}", "settle": 1.5}, {"do": "toast", "html": "👤 Client's view of the proposal", "ms": 2400}, {"do": "scroll_to", "text": "Choose your plan"}]},

    {"id": "checkout", "pad": 0.2, "squeeze": 12,
     "say": "They subscribe to the Growth plan and approve it in PayPal.",
     "actions": [{"do": "click", "text": "Subscribe with PayPal"}, {"do": "paypal_approve", "return_pattern": "/return"}]},

    {"id": "paid", "min": 3.2,
     "say": "The subscription is live.",
     "actions": [{"do": "wait_for", "text": "subscription is active"}, {"do": "move", "text": "subscription is active"}]},

    {"id": "handover",
     "say": "Nobody types anything. The deal is won, and the project manager agent plans delivery across nine departments.",
     "actions": [{"do": "goto", "url": "{base}/", "settle": 2.5}, {"do": "click", "sel": "[data-v=ops]"}, {"do": "wait_for", "text": "Lifecycle 0/9", "timeout": 20},
                 {"do": "move", "text": "Lifecycle 0/9"}, {"do": "wait", "s": 0.6}, {"do": "click", "text": "Open lifecycle"}, {"do": "wait_for", "text": "Requirement analysis"}]},

    {"id": "agents", "squeeze": 6,
     "say": "Department agents go to work: requirements and estimate, sprint plan, design, architecture, tests, deployment, handover, and billing.",
     "actions": [{"do": "click", "sel": "[data-act=proj_run_all]"}, {"do": "wait_for", "text": "ready for your approval", "timeout": 240}, {"do": "wait", "s": 1.2}]},

    {"id": "review",
     "say": "Every deliverable is written for this client, and waits for a human to approve it. The security review stays with Priya, a person.",
     "actions": [{"do": "move", "text": "written by the AI agent"}, {"do": "eval", "js": "document.querySelector('#drawer').scrollBy({top: 650, behavior: 'smooth'})"},
                 {"do": "wait", "s": 1.6}, {"do": "scroll_to", "text": "Security review checklist"}, {"do": "move", "text": "Mark done"}, {"do": "wait", "s": 0.8},
                 {"do": "eval", "js": "document.querySelector('#drawer').scrollTo({top: 0, behavior: 'smooth'})"}, {"do": "wait", "s": 1.0}, {"do": "click", "text": "✓ Approve"}]},

    {"id": "finance",
     "say": "And the finance agent bills in plain English. It never moves money without my confirmation.",
     "actions": [{"do": "click", "sel": "[data-act=close]"}, {"do": "click", "sel": "[data-v=copilot]"}, {"do": "wait_for", "sel": "#chat_in"},
                 {"do": "type", "sel": "#chat_in", "text": "Invoice CloudPulse for the one-time sprint", "delay": 0.03},
                 {"do": "click", "sel": "[data-act=send_chat]"}, {"do": "wait_for", "text": "Confirm: invoice", "timeout": 30},
                 {"do": "click", "text": "Confirm: invoice"}, {"do": "wait_for", "text": "sent for $", "timeout": 60}, {"do": "move", "text": "sent for $"}]},

    {"id": "close", "min": 9,
     "say": "Dealwright. PayPal Orders, Subscriptions, Invoicing and Webhooks, and a company of AI agents, with a human in the loop.",
     "actions": [{"do": "card", "title": "Dealwright", "subtitle": "PayPal Orders · Subscriptions · Invoicing · Refunds · Webhooks<br>20 departments · 9-stage delivery lifecycle · people + AI agents · human approval<br><span style='color:#cbd5e1;font-size:24px'>github.com/Muhammad-Tayyab-Bhutto/Leado</span>", "ms": 0}]}
  ]
}
